#!/bin/sh
# SCBrowser launcher - generated by scripts/build-app.sh - do not edit directly.
DIR="$(dirname "$0")"
CONTENTS="$(dirname "$DIR")"
EXT="$CONTENTS/Resources/SCBrowserExtension"
PROFILE="${SCBROWSER_PROFILE:-$HOME/Library/Application Support/SCBrowser}"
mkdir -p "$PROFILE"
exec "$DIR/Chromium" \
  --user-data-dir="$PROFILE"\
  --remote-debugging-port=9222\
  --load-extension="$EXT"\
  --window-size=1280,900\
  --no-first-run\
  --no-default-browser-check\
  --disable-default-apps\
  --disable-component-update\
  --disable-background-networking\
  --disable-sync\
  --disable-translate\
  --disable-hang-monitor\
  --disable-prompt-on-repost\
  --disable-field-trial-config\
  --disable-breakpad\
  --metrics-recording-only\
  --no-pings\
  --disable-client-side-phishing-detection\
  --safebrowsing-disable-download-protection\
  --renderer-process-limit=2\
  --js-flags=--max-old-space-size=256\
  --disk-cache-size=52428800\
  --media-cache-size=52428800\
  --ignore-gpu-blocklist\
  --webrtc-ip-handling-policy=disable-non-proxied-udp\
  --force-webrtc-ip-handling-policy=disable-non-proxied-udp\
  --fingerprinting-canvas-image-noise\
  --fingerprinting-canvas-measure-noise\
  --fingerprinting-client-rects-noise\
  --enable-do-not-track\
  --disable-privacy-sandbox\
  --disable-features=Translate,MediaRouter,DialMediaRouteProvider,OptimizationHints,OptimizationGuideModelDownloading,OptimizationGuideOnDeviceModel,InterestHints,PrivacySandbox,CalculateNativeWinOcclusion,WebBluetooth,WebUSB,WebSerial,WebHID,FileSystemAccessAPI,Printing,DesktopSharingHub,DnsOverHttps,ThirdPartyCookiePhaseout\
  --enable-unsafe-extension-debugging\
  --disable-session-crashed-bubble \
  "$@"
